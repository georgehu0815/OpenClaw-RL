flowchart LR

%% ── nodes ──────────────────────────────────────────────────

DS[("📂 Task Dataset<br/>sample_tasks.jsonl")]

ORCH["🔵 Orchestrator<br/>train_async.py"]

ENV["🟠 Env Pool<br/>local_env_pool.py<br/>terminal_env.py"]

AGENT["🟣 Agent Loop<br/>agent_loop.py"]

POLICY["🟢 Policy Server<br/>oMLX  :8080<br/>Qwen3-8B-4bit"]

BUF["🔵 Rollout Buffer<br/>rollout_buffer.py<br/>GRPO advantage"]

PRM["🟣 PRM  ⟨opt⟩<br/>prm_client.py<br/>oMLX  :8081"]

TRAIN["🔴 Trainer<br/>mlx-tune<br/>GRPOTrainer"]

%% ── edges ──────────────────────────────────────────────────

DS      -->|"tasks"| ORCH
ORCH    -->|"allocate"| ENV
ENV     -->|"observation"| AGENT
AGENT   -->|"bash cmd"| ENV
AGENT   -->|"messages"| POLICY
POLICY  -->|"response"| AGENT
ENV     -->|"score + trajectory"| BUF
BUF     -.->|"step scores"| PRM
PRM     -.->|"turn scores"| BUF
BUF     -->|"GRPO batch"| TRAIN
TRAIN   -->|"weight sync"| POLICY

