%%{
  init: {
    "theme": "base",
    "themeVariables": {
      "fontFamily": "Inter, Helvetica Neue, sans-serif",
      "fontSize": "22px",
      "primaryColor": "#0D2137",
      "primaryTextColor": "#E8F4FD",
      "primaryBorderColor": "#4FC3F7",
      "lineColor": "#90CAF9",
      "background": "#0A1929",
      "mainBkg": "#0A1929",
      "clusterBkg": "#0D2137",
      "clusterBorder": "#4FC3F7",
      "titleColor": "#E8F4FD",
      "edgeLabelBackground": "#0D2137"
    }
  }
}%%
graph LR
    DS["Task Dataset"]

    subgraph training_machine["Training Machine"]
        direction TB
        SL["Slime Orchestrator"]

        subgraph inference_col["Rollout Inference"]
            SG["SGLang Server\nTP=2"]
            CA["CAMEL Agent"]
        end

        RT["Router Server\n:18080"]
        RB["Rollout Buffer"]
        PRM["PRM Judge\nm=3 vote"]

        subgraph train_col["Megatron Training"]
            GR["GRPO Update"]
            MG["Megatron Actor\nTP=4"]
        end
    end

    subgraph worker_pool["Remote Workers"]
        direction TB
        PS["Pool Server\n:18081"]
        DC["Docker\nContainers"]
    end

    subgraph obs["Observability"]
        WB["W&B"]
        LG["JSONL Log"]
    end

    DS -->|prompts| SL
    SL -->|generate| CA
    CA <-->|LLM call| SG
    CA -->|tool call| RT
    RT -->|route + lease| PS
    PS -->|bash exec| DC
    DC -->|observation| PS
    PS -->|result| RT
    RT -->|observation| CA
    CA -->|score| RB
    RB -->|step rewards| PRM
    PRM -->|weighted reward| RB
    RB -->|scored batch| GR
    GR --> MG
    MG -->|weight sync| SG
    SL -->|metrics| WB
    SL -->|trace| LG

    style training_machine fill:#091825,stroke:#4FC3F7,stroke-width:3px,color:#E8F4FD
    style inference_col fill:#0A1F35,stroke:#00B4D8,stroke-width:2px,color:#CAF0F8
    style train_col fill:#160A28,stroke:#9C27B0,stroke-width:2px,color:#F3E5F5
    style worker_pool fill:#1A0808,stroke:#EF5350,stroke-width:3px,color:#FFCDD2
    style obs fill:#0A180A,stroke:#66BB6A,stroke-width:2px,color:#C8E6C9

    style DS fill:#1B5E20,stroke:#4CAF50,stroke-width:2px,color:#E8F5E9
    style SL fill:#0D47A1,stroke:#42A5F5,stroke-width:2px,color:#E3F2FD
    style SG fill:#006278,stroke:#00B4D8,stroke-width:2px,color:#CAF0F8
    style CA fill:#004D6D,stroke:#00B4D8,stroke-width:2px,color:#CAF0F8
    style RT fill:#1A3A1A,stroke:#66BB6A,stroke-width:2px,color:#C8E6C9
    style RB fill:#1A237E,stroke:#7986CB,stroke-width:2px,color:#E8EAF6
    style PRM fill:#7B3F00,stroke:#F59E0B,stroke-width:2px,color:#FEF3C7
    style GR fill:#6A1B9A,stroke:#CE93D8,stroke-width:2px,color:#F3E5F5
    style MG fill:#4A148C,stroke:#CE93D8,stroke-width:2px,color:#F3E5F5
    style PS fill:#7F1717,stroke:#EF5350,stroke-width:2px,color:#FFCDD2
    style DC fill:#5C1010,stroke:#EF9A9A,stroke-width:2px,color:#FFCDD2
    style WB fill:#1B3A1B,stroke:#66BB6A,stroke-width:2px,color:#C8E6C9
    style LG fill:#1B3A1B,stroke:#66BB6A,stroke-width:2px,color:#C8E6C9

