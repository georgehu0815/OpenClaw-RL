  init: {
    "theme": "base",
    "themeVariables": {
      "fontFamily": "Inter, Helvetica Neue, sans-serif",
      "fontSize": "24px",
      "primaryColor": "#00B4D8",
      "primaryTextColor": "#FFFFFF",
      "primaryBorderColor": "#007EA7",
      "lineColor": "#90E0EF",
      "secondaryColor": "#1E3A5F",
      "tertiaryColor": "#0A1929",
      "background": "#0A1929",
      "mainBkg": "#0A1929",
      "clusterBkg": "#112240",
