graph TD
    DS["Task Dataset\nseta_env JSONL"]

    subgraph mac["Apple Silicon Mac — Unified Memory"]
        direction TB

        AL["Async RL Loop\ntrain_async.py"]

        subgraph agent_col["Agent Loop  (asyncio + openai client)"]
            AG["AgentLoop\nmulti-turn tool-call"]
            EV["LocalEnvPool\nTerminalEnv · Docker"]
        end

        OP["oMLX Policy Slot\nQwen3-8B · 4-bit\n/v1/chat/completions"]

        RB["Rollout Buffer\nasyncio.Queue"]

        PR["oMLX PRM Slot\nQwen3-4B · 4-bit\nmajority vote × m\n(optional)"]

        subgraph train_col["mlx-tune"]
            MT["GRPOTrainer\nLoRA / full · MLX"]
        end
    end

    subgraph obs["Observability"]
        WB["W&B"]
        LG["JSONL Log"]
    end

    DS -->|prompts| AL
    AL -->|dispatch| AG
    AG <-->|/v1/chat/completions| OP
    AG <-->|exec bash · observe| EV
    AG -->|scored trajectory| RB
    RB <-->|step rewards| PR
    RB -->|scored batch| MT
    MT -->|weight sync| OP
    AL -->|metrics| WB
    AL -->|trace| LG

