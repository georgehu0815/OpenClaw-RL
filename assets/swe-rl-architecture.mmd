  init: {
    "theme": "base",
    "themeVariables": {
      "fontFamily": "Inter, Helvetica Neue, sans-serif",
      "fontSize": "20px",
      "primaryColor": "#0D2137",
      "primaryTextColor": "#E8F4FD",
      "primaryBorderColor": "#4FC3F7",
      "lineColor": "#90CAF9",
      "background": "#0A1929",
      "mainBkg": "#0A1929",
      "clusterBkg": "#0D2137",
      "clusterBorder": "#4FC3F7",
      "titleColor": "#E8F4FD",
      "edgeLabelBackground": "#0D2137"
    }
  }
}%%
graph LR
    DS["SWE-Bench\nSWE-Gym\nJSONL"]

    subgraph head["GPU Head Node  (Ray Cluster · Slime)"]
        direction TB

        subgraph rollout["Rollout  (generate_with_swe_remote.py)"]
            direction TB
            AG["Agent Loop\n_run_agent_remote\nup to 20 turns"]
            CM["Context Manager\nhead 30% + tail 70%\ntruncation"]
            EC["swe_env_client\nHTTP async client"]
        end

        PO["SGLang Policy\nQwen3-32B / 8B\nlitellm acompletion"]

        PS["Pool Server\n:18090\nleast-loaded routing"]

        subgraph reward_tier["Reward"]
            direction TB
            EV["Patch Eval\nfresh container\ngit apply + pytest\n+1 resolved / -1 failed"]
            PR["PRM\nswe_prm.py\nmajority vote x m\n(optional)"]
        end

        subgraph training["GRPO Training  (Megatron-LM)"]
            direction TB
            RB["Rollout Buffer\nn=8 per prompt\nadvantage A_i"]
            MT["Megatron Actor\nGRPO loss\nKL penalty · LR 1e-6"]
        end
    end

    subgraph ecs["ECS Docker Nodes  (1-N)"]
        direction TB
        ES["swe_exec_server.py\n:5000  per node"]
        DC["Docker Containers\nPython repo · /testbed\n4GB RAM · 256 PIDs"]
    end

    subgraph obs["Artifacts"]
        direction TB
        WB["W&B"]
        TR["traj.json\npatch.diff"]
    end

    DS -->|"problem_statement\n+ instance"| AG
    AG <-->|"build context\ntruncate"| CM
    AG <-->|"/v1/chat/completions\nbash tool call"| PO
    AG -->|"exec_tool\n(bash cmd)"| EC
    EC -->|"allocate · exec\ndiff · evaluate · close"| PS
    PS -->|"route lease\nHTTP"| ES
    ES <-->|"docker exec\nbash -lc"| DC
    DC -->|"returncode\nstdout/stderr"| ES
    ES -->|observation| PS
    PS -->|observation| EC
    EC -->|observation| AG
    AG -->|"submit patch\nor git diff"| EV
    AG <-->|"async step\nscoring"| PR
    AG -->|"scored\ntrajectory"| RB
    RB --> MT
    MT -->|"weight sync"| PO
    AG -->|metrics| WB
    AG -->|rollout| TR

